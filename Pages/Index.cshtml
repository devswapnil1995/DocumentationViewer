@page
@model IndexModel
@{
    ViewData["Title"] = "Documentation Viewer";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1>📚 Documentation Viewer</h1>
            <p class="text-muted">Browse all project documentation in one place</p>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="post" class="input-group">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search documentation..." value="@Model.SearchQuery">
                <button class="btn btn-primary" type="submit" name="searchBtn" value="search">
                    <i class="fas fa-search"></i> Search
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="/" class="btn btn-secondary">Clear</a>
                }
            </form>
        </div>
    </div>

    <!-- Documents List -->
    @if (Model.Documents.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <h3>
                    @if (string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <span>All Documents (@Model.Documents.Count)</span>
                    }
                    else
                    {
                        <span>Search Results (@Model.Documents.Count)</span>
                    }
                </h3>
                <div class="list-group">
                    @foreach (var doc in Model.Documents)
                    {
                        <a href="/view?file=@Uri.EscapeDataString(doc.FileName)" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="mb-1">
                                        <i class="fas fa-file-alt"></i> @doc.Title
                                    </h5>
                                    <p class="mb-1 text-muted small">
                                        @doc.FileName
                                    </p>
                                </div>
                                <div class="text-end text-muted small">
                                    <p class="mb-0">@doc.LastModified.ToString("MMM dd, yyyy")</p>
                                    <p class="mb-0">@(doc.FileSize / 1024) KB</p>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            @if (string.IsNullOrEmpty(Model.SearchQuery))
            {
                <p>No documentation found. Please ensure markdown files exist in the Docs folder.</p>
            }
            else
            {
                <p>No documents match your search for "<strong>@Model.SearchQuery</strong>"</p>
            }
        </div>
    }
</div>

<style>
    .list-group-item-action:hover {
        background-color: #f8f9fa;
    }
    h1 {
        color: #2c3e50;
        border-bottom: 3px solid #3498db;
        padding-bottom: 10px;
    }
</style>
